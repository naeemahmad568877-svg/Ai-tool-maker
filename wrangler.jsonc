
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-tool-maker-backed",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "TOOLS_KV",
      "id": "e16498bffe534fa4b2e354c91beddea5"
    }
  ]
}
