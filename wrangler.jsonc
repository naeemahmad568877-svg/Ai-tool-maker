{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-tool-maker-backed",
  "main": "./worker.js",
  "compatibility_date": "2026-11-03",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/tool/*",
      "/"
    ]
  },

  "ai": {
    "binding": "AI"
  },

  "kv_namespaces": [
    {
      "binding": "TOOLS_KV",
      "id": "YAHAN_APNA_ASLI_KV_NAMESPACE_ID_LAGAYEN"
    }
  ]
}