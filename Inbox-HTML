label{display:block;margin:12px 0 6px;font-weight:700}input,textarea,select{width:100%;border:1px solid #424c70;border-radius:12px;padding:12px;background:#11172a;color:var(--text);font:inherit}textarea{min-height:105px;resize:vertical}button{font:inherit}.btn{border:0;border-radius:12px;padding:10px 14px;cursor:pointer;font-weight:800;background:var(--accent);color:#101322}.btn.secondary{background:#2b3452;color:var(--text);border:1px solid var(--line)}.btn.green{background:var(--mint)}.btn.danger{background:var(--danger);color:#241018}.btn:disabled{opacity:.55;cursor:not-allowed}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:13px}.tool{border:1px solid var(--line);border-radius:15px;padding:15px;background:#171d30}.tool h3{margin:5px 0}.tool p{color:var(--muted);font-size:.94rem;overflow-wrap:anywhere}.hidden{display:none!important}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.previewBox{background:#f6f7fb;color:#182036;border-radius:12px;overflow:hidden;min-height:200px}.previewBox iframe{width:100%;height:570px;border:0;background:white}.code{direction:ltr;text-align:left;white-space:pre-wrap;overflow-wrap:anywhere;background:#0b1020;border:1px solid var(--line);border-radius:12px;padding:14px;max-height:330px;overflow:auto;font:12px ui-monospace,monospace}.empty{text-align:center;padding:24px;color:var(--muted)}.footer{text-align:center;color:var(--muted);font-size:.85rem;padding:18px 0}.tip{background:#11172a;border:1px solid var(--line);border-radius:12px;padding:12px;color:var(--muted)}.stat{background:#11172a;border:1px solid var(--line);border-radius:13px;padding:13px}.stat b{font-size:1.4rem;color:var(--mint)}.status{padding:8px 11px;border-radius:9px;background:#153b36;color:#9df4d8;margin:7px 0}.warning{background:#3b2b17;color:#ffdda0}.error{background:#3b1e2a;color:#ffb8c4}.pill{display:inline-block;border:1px solid var(--line);padding:3px 8px;border-radius:20px;color:var(--muted);font-size:.8rem}.two{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}.metric{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line);padding:7px 0}.check{display:flex;align-items:center;gap:8px}.check input{width:auto}
@media(max-width:700px){.wrap{padding:11px}.card{padding:13px}.row,.two{grid-template-columns:1fr}.hero{padding-top:8px}.previewBox iframe{height:600px}}
