<div class="footer">AI Tool Maker Pro v6 • Local HTML Builder • Project Manager</div></div>

<script>
"use strict";
const $=id=>document.getElementById(id),KEY="aitoolmaker_projects_v6";
let currentId=null,universalDraft=null,corePlan="";
const NAMES={text:"تحریر",story:"کہانی",image:"تصویر پرامپٹ",video:"ویڈیو پلان",audio:"آڈیو / وائس",script:"اسکرپٹ",ideas:"خیالات",code:"کوڈ ہیلپر",translator:"ترجمہ",chatbot:"چیٹ اسسٹنٹ",calculator:"کیلکولیٹر",planner:"پلانر"};
const PRESETS=[["text","✍️ تحریر","مضمون، خلاصہ، خط اور وضاحت"],["translator","🌍 ترجمہ","زبانوں کے درمیان ترجمے کا انٹرفیس"],["chatbot","💬 چیٹ اسسٹنٹ","سوال و جواب کا انٹرفیس"],["image","🖼️ تصویر","تصویر کے پرامپٹس"],["video","🎬 ویڈیو","سین اور شاٹ پلان"],["audio","🎙️ آڈیو","وائس اوور اسکرپٹ"],["code","💻 کوڈ","کوڈ کی وضاحت اور منصوبہ"],["calculator","🧮 کیلکولیٹر","حساب کتاب"],["planner","📋 پلانر","کاموں کی فہرست"],["ideas","💡 آئیڈیاز","عنوانات اور تخلیقی خیالات"]];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const safeFile=s=>String(s||"my-tool").replace(/[^a-z0-9\u0600-\u06FF]+/gi,"-").replace(/^-+|-+$/g,"").slice(0,55)||"my-tool";
const kindName=k=>NAMES[k]||"جنرل ٹول";
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function all(){try{let raw=localStorage.getItem(KEY);if(raw===null){raw=localStorage.getItem("aitoolmaker_projects_v5");if(raw!==null)localStorage.setItem(KEY,raw)}let x=JSON.parse(raw||"[]");return Array.isArray(x)?x:[]}catch(e){return[]}}
function store(a){try{localStorage.setItem(KEY,JSON.stringify(a));return true}catch(e){alert("براؤزر کی جگہ کم ہے؛ بیک اپ ڈاؤن لوڈ کریں یا پرانے پروجیکٹس کم کریں۔");return false}}
function guessKind(s){s=String(s).toLowerCase();if(/ترجمہ|translate/.test(s))return"translator";if(/چیٹ|chatbot|assistant/.test(s))return"chatbot";if(/کیلکولیٹر|حساب|calculator/.test(s))return"calculator";if(/پلانر|منصوبہ|planner|task/.test(s))return"planner";if(/تصویر|image|photo|picture/.test(s))return"image";if(/ویڈیو|video|سین|scene/.test(s))return"video";if(/آواز|voice|audio/.test(s))return"audio";if(/کوڈ|code|html|javascript/.test(s))return"code";if(/کہانی|story|فلم/.test(s))return"story";if(/اسکرپٹ|script/.test(s))return"script";if(/عنوان|خیال|ideas/.test(s))return"ideas";return"text"}
function safeCalc(expr){if(!/^[0-9+*/().%\s-]+$/.test(expr))throw Error("صرف بنیادی ریاضی کی علامات استعمال کریں۔");let i=0;function ws(){while(/\s/.test(expr[i]||"")&&i<expr.length)i++}function factor(){ws();if(expr[i]==="+"){i++;return factor()}if(expr[i]==="-"){i++;return-factor()}if(expr[i]==="("){i++;let v=sum();ws();if(expr[i++]!==")")throw Error("قوس مکمل نہیں۔");return v}let m=expr.slice(i).match(/^(?:\d+\.?\d*|\.\d+)/);if(!m)throw Error("حساب درست نہیں۔");i+=m[0].length;return Number(m[0])}function term(){let v=factor();while(true){ws();let op=expr[i];if(!["*","/","%"].includes(op))break;i++;let n=factor();if((op==="/"||op==="%")&&n===0)throw Error("صفر سے تقسیم نہیں ہو سکتی۔");v=op==="*"?v*n:op==="/"?v/n:v%n}return v}function sum(){let v=term();while(true){ws();let op=expr[i];if(op!=="+"&&op!=="-")break;i++;let n=term();v=op==="+"?v+n:v-n}return v}let r=sum();ws();if(i!==expr.length||!Number.isFinite(r))throw Error("حساب مکمل یا درست نہیں۔");return r}
function localGenerate(kind,input,style,lang){let out="";switch(kind){
case"calculator":try{out="حساب کا نتیجہ: "+safeCalc(input)}catch(e){out="درست حساب لکھیں، مثلاً (25+15)*2۔"}break;
case"translator":out="ترجمہ ڈیمو\nاصل متن: "+input+"\nہدف زبان منتخب کریں۔ حقیقی ترجمے کے لیے Backend AI کنکشن درکار ہے۔";break;
case"chatbot":out="چیٹ اسسٹنٹ ڈیمو\nآپ کا سوال: "+input+"\nیہ مقامی ڈیمو ہے؛ حقیقی AI جواب کے لیے Backend API درکار ہے۔";break;
