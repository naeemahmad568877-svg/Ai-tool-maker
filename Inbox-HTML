$("importBtn").onclick=()=>$("importFile").click();$("importFile").onchange=async e=>{let f=e.target.files?.[0];if(!f)return;try{let j=JSON.parse(await f.text()),incoming=Array.isArray(j)?j:j.projects;if(!Array.isArray(incoming))throw Error("invalid");let a=all(),ids=new Set(a.map(x=>x.id)),n=0;for(let p of incoming){if(p&&p.id&&p.title&&!ids.has(p.id)){p.html=makeToolHTML(p);a.push(p);ids.add(p.id);n++}}if(store(a)){refresh();alert(n+" پروجیکٹس درآمد ہوگئے۔")}}catch(_){alert("یہ درست بیک اپ فائل نہیں۔")}e.target.value=""};
refresh();
</script></body></html>
